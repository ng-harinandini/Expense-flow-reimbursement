# ExpenseFlow backend environment — copy to .env and fill in. Never commit the real .env.

# --- App ---
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API (scheme + host + port, no path).
# Left empty, no cross-origin browser caller is permitted.
FE_URL=http://localhost:3000

# --- AI policy rule extraction ---
# Bedrock uses the boto3 credential chain (or AWS_BEARER_TOKEN_BEDROCK).
AI_RULE_EXTRACTION_PROVIDER=bedrock
AI_RULE_EXTRACTION_MODEL=google.gemma-3-4b-it
AI_BEDROCK_REGION=us-east-1
# 45s silently truncates real extraction requests on larger models (measured 71.5s for one
# window against google.gemma-3-12b-it with the v3 prompt) — the call errors out mid-page rather
# than returning a short answer, so a low value here reads as "half the document went missing".
AI_LLM_TIMEOUT_SECONDS=150
AI_LLM_MAX_OUTPUT_TOKENS=8192
AI_LLM_TEMPERATURE=0.0
# Extraction returns a much richer object per rule than the advisory LLM path, so it has its own
# output budget. Too small and the JSON is truncated — which reads as "this page had no rules".
AI_RULE_EXTRACTION_MAX_OUTPUT_TOKENS=8192
# A long page is sent in overlapping windows instead of being truncated.
AI_RULE_EXTRACTION_MAX_CHARS_PER_WINDOW=9000
AI_RULE_EXTRACTION_WINDOW_OVERLAP_CHARS=800
# Selects a template from app/ai/extraction/prompts/ (v1, v2, ...) — roll back or trial a prompt
# change purely via this var, no code deploy required.
AI_RULE_EXTRACTION_PROMPT_VERSION=v3

# --- AI expense document classification ---
# Separate on/off switch and model from rule extraction above — a generative capability must be
# switched on deliberately, never merely by deploying this code.
AI_CLASSIFICATION_ENABLED=false
AI_CLASSIFICATION_PROVIDER=bedrock
AI_CLASSIFICATION_MODEL=google.gemma-3-12b-it
AI_CLASSIFICATION_MAX_OUTPUT_TOKENS=1024
# Below this, even a name match on suggestedCategory is still flagged for manual review.
AI_CLASSIFICATION_MIN_CONFIDENCE=0.7
# Kill switch for sending the receipt image alongside the OCR text. Set false to classify from text
# alone, which is also what the layer degrades to by itself whenever a receipt cannot be decoded.
AI_CLASSIFICATION_INCLUDE_IMAGE=true
# PDF receipts are rasterized to PNG before being sent (a vision model cannot read a PDF). How many
# pages to send, 1-3. Multi-image requests were verified against google.gemma-3-12b-it on
# 2026-08-12 (a two-page invoice was sent; the model reported seeing both pages), so >1 is safe on
# that model. Each extra page is another image on a request that runs inside claim submission, so
# lower this to 1 if submission latency matters more than seeing later pages. Pages beyond the cap
# are counted and logged rather than silently dropped.
AI_CLASSIFICATION_MAX_PDF_PAGES=3
# Render scale for those pages (1.0-4.0); 2.0 is ~144 DPI. The result is capped at 2000px on its
# longest edge regardless, so this mostly trades CPU for legibility.
AI_CLASSIFICATION_PDF_RENDER_SCALE=2.0
AI_CLASSIFICATION_TIMEOUT_SECONDS=30

# --- AI receipt extraction (which engine reads an uploaded receipt) ---
# textract = AWS Textract AnalyzeExpense (the original path, and the default).
# bedrock  = one multimodal Gemma call that returns the same summary *and* a category suggestion,
#            so the submission form can be pre-filled before a claim exists. Textract cannot suggest
#            a category at all. The category list and its per-category fields are read from the
#            database on every request, so adding or renaming a category needs no deploy.
# The two are strict alternatives: a failure on the bedrock path returns the same empty result
# Textract returns when disabled, rather than silently falling back to the other engine.
AI_RECEIPT_EXTRACTION_PROVIDER=textract
# Required when the provider is bedrock. Must be a multimodal model — a receipt is an image.
AI_RECEIPT_EXTRACTION_MODEL=google.gemma-3-12b-it
# One call carries the summary, the line items and the category's fields, so it needs a larger
# budget than classification's: truncated JSON is unparseable and costs the whole extraction.
AI_RECEIPT_EXTRACTION_MAX_OUTPUT_TOKENS=4096
AI_RECEIPT_EXTRACTION_TIMEOUT_SECONDS=45
# PDF rendering for this path reuses AI_CLASSIFICATION_MAX_PDF_PAGES and
# AI_CLASSIFICATION_PDF_RENDER_SCALE above rather than duplicating them.

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL verbatim, or the DB_* parts below.
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
# search_path pinned on every connection (optional; unset uses the DB role's default schema).
DB_SCHEMA=

# --- SSH tunnel (optional) ---
# Set when DB_HOST is only reachable through a bastion host (e.g. a private-VPC RDS instance).
# When enabled, the app/Alembic connect through 127.0.0.1:<tunnel port> instead of DB_HOST directly.
SSH_TUNNEL_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=ec2-user
# AWS Secrets Manager secret holding the bastion's PEM private key (JSON field "ipd_rds_ca_cert" or raw PEM text).
SSH_SECRET_NAME=
SSH_SECRET_REGION=

# --- AWS / S3 / Textract ---
AWS_REGION=us-east-1
S3_BUCKET_NAME=
TEXTRACT_ENABLED=false

# --- Category policy engine (legacy) ---
# Gates the older, category-keyed engine (`policy_rules` table). Superseded by the database-driven
# `claim_policy_rules` engine (doc/travel-policy-rules.md), which always runs regardless of this
# flag. Off by default; set true to have submitted claims consult `policy_rules` again.
POLICY_RULES_ENGINE_ENABLED=false

# --- AWS Cognito (authentication) ---
# Region is auto-derived from the pool id prefix (e.g. ap-south-1_xxxxx) if COGNITO_REGION is unset.
COGNITO_REGION=
COGNITO_USER_POOL_ID=ap-south-1_xxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxx
# Only if the app client has a secret (SECRET_HASH is then required on login):
COGNITO_APP_CLIENT_SECRET=

# Bootstrap admin for Cognito provisioning (T002 provisioning script; no password here):
BOOTSTRAP_ADMIN_EMAIL=
# Optional display name for the bootstrap admin (pool requires 'name'); defaults to the email local-part:
BOOTSTRAP_ADMIN_NAME=
