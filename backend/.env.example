# ExpenseFlow backend environment — copy to .env and fill in. Never commit the real .env.

# --- App ---
GEMINI_API_KEY=

# --- Database (PostgreSQL) ---
# Either set DATABASE_URL verbatim, or the DB_* parts below.
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
# search_path pinned on every connection (optional; unset uses the DB role's default schema).
DB_SCHEMA=

# --- SSH tunnel (optional) ---
# Set when DB_HOST is only reachable through a bastion host (e.g. a private-VPC RDS instance).
# When enabled, the app/Alembic connect through 127.0.0.1:<tunnel port> instead of DB_HOST directly.
SSH_TUNNEL_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=ec2-user
# AWS Secrets Manager secret holding the bastion's PEM private key (JSON field "ipd_rds_ca_cert" or raw PEM text).
SSH_SECRET_NAME=
SSH_SECRET_REGION=

# --- AWS / S3 / Textract ---
AWS_REGION=us-east-1
S3_BUCKET_NAME=
TEXTRACT_ENABLED=false

# --- AWS Cognito (authentication) ---
# Region is auto-derived from the pool id prefix (e.g. ap-south-1_xxxxx) if COGNITO_REGION is unset.
COGNITO_REGION=
COGNITO_USER_POOL_ID=ap-south-1_xxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxx
# Only if the app client has a secret (SECRET_HASH is then required on login):
COGNITO_APP_CLIENT_SECRET=

# Bootstrap admin for Cognito provisioning (T002 provisioning script; no password here):
BOOTSTRAP_ADMIN_EMAIL=
# Optional display name for the bootstrap admin (pool requires 'name'); defaults to the email local-part:
BOOTSTRAP_ADMIN_NAME=
